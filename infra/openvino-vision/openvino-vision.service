[Unit]
Description=LinkHealth OpenVINO Vision showcase (pose estimation)
After=network.target

[Service]
Type=simple
User=fmlin
WorkingDirectory=/opt/openvino-vision
ExecStart=/opt/openvino-vision/venv/bin/uvicorn serve:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
