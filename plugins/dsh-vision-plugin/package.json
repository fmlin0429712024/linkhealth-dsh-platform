{
  "name": "dsh-vision-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "LinkHealth Vision for DeepSeek Harness: assess_exercise_form tool that checks PT/rehab exercise form (bicep-curl elbow angle) by calling a vision-backend pose-estimation service through a baseUrl config entry and applying a deterministic geometric rule. Never bundles the inference model itself.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "vision",
    "pose-estimation",
    "exercise-form",
    "physical-therapy",
    "linkhealth"
  ],
  "author": {
    "name": "fmlin",
    "email": "fmlin0429712024@gmail.com"
  },
