node_modules/
.DS_Store
__pycache__/
*.pyc
.env
.env.*

# Local-only agent tooling — never a public deliverable of this repo
CLAUDE.md
.claude/
DSH-HANDOFF-PROMPT.md

# Machine-local DSH test homes (contain credentials copies — never commit)
.dsh-test-home/
.dsh-e2e-home/

# Local working clone(s) of upstream OpenVINO kits (separate apps, own repo/
# history, deployed manually per docs/PRD-vision-insights.md — not a
# deliverable of this repo, and the LFS video would bloat it)
infra/openvino-queue-kit/repo/
infra/openvino-self-checkout/repo/

# Local venv + scratch SQLite db for the Insight Storage layer
# (infra/vision-insights-store) — deployed venv is provisioned on the VM the
# same way, not shipped here. Scoped to this directory only — dsh-cdi-plugin
# intentionally commits its own .db files elsewhere in the repo.
infra/vision-insights-store/venv/
infra/vision-insights-store/*.db
infra/vision-insights-store/*.db-shm
infra/vision-insights-store/*.db-wal

# Runtime data written by plugins into the workspace root (e.g. triage log)
/data/
